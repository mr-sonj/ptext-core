{
  "name": "@ptext/cli",
  "version": "0.3.0",
  "description": "Text tools for the terminal: remove duplicate lines, CSV to JSON, extract emails, URLs and IPs, clean lines, JSON format and validate. stdin to stdout, JSON mode for PHP/Laravel, Python and shell scripts.",
  "type": "module",
  "engines": { "node": ">=22" },
  "bin": {
    "ptext": "./dist/cli.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ptext/core": "workspace:*"
  },
  "keywords": ["cli", "text-tools", "text", "remove-duplicates", "dedupe", "csv-to-json", "csv", "json", "json-formatter", "extract-emails", "clean-text", "base64", "url-decode", "laravel", "php"],
  "license": "MIT",
  "author": "Sonjj",
  "homepage": "https://github.com/mr-sonj/ptext-core/tree/main/packages/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mr-sonj/ptext-core.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/mr-sonj/ptext-core/issues",
  "publishConfig": { "access": "public" }
}
