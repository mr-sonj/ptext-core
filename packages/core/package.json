{
  "name": "@ptext/core",
  "version": "0.3.0",
  "description": "Deterministic text tools: remove duplicate lines, CSV to JSON, extract emails, URLs, domains and IPs, clean lines, split columns, Base64/URL decode, JSON format and validate. Zero dependencies; runs in browser, Cloudflare Workers, Node, Deno, Bun.",
  "type": "module",
  "engines": { "node": ">=22" },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": ["text", "text-tools", "text-processing", "remove-duplicates", "dedupe", "csv", "csv-to-json", "json", "json-formatter", "json-validator", "extract-emails", "email-extractor", "url-extractor", "clean-text", "base64", "url-encode", "deterministic", "zero-dependency", "browser", "cloudflare-workers"],
  "license": "MIT",
  "author": "Sonjj",
  "homepage": "https://github.com/mr-sonj/ptext-core/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mr-sonj/ptext-core.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/mr-sonj/ptext-core/issues",
  "publishConfig": { "access": "public" }
}
