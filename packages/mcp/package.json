{
  "name": "@ptext/mcp",
  "version": "0.3.0",
  "description": "PText MCP server — stdio (local) and Web-standard Streamable HTTP (Cloudflare Workers, Deno, Bun).",
  "type": "module",
  "engines": { "node": ">=22" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ptext-mcp": "./dist/stdio.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/stdio.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@ptext/core": "workspace:*"
  },
  "keywords": ["mcp", "model-context-protocol", "mcp-server", "text", "extract", "csv", "json", "cloudflare-workers"],
  "license": "MIT",
  "author": "Sonjj",
  "homepage": "https://github.com/mr-sonj/ptext-core/tree/main/packages/mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mr-sonj/ptext-core.git",
    "directory": "packages/mcp"
  },
  "bugs": "https://github.com/mr-sonj/ptext-core/issues",
  "publishConfig": { "access": "public" }
}
