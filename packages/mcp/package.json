{
  "name": "@ptext/mcp",
  "version": "0.3.0",
  "description": "MCP server with deterministic text tools for Claude, Cursor, Codex and other AI assistants: remove duplicate lines, CSV to JSON, extract emails, JSON format, clean text. stdio and Streamable HTTP (Cloudflare Workers, Deno, Bun).",
  "type": "module",
  "engines": { "node": ">=22" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ptext-mcp": "./dist/stdio.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/stdio.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@ptext/core": "workspace:*"
  },
  "keywords": ["mcp", "mcp-server", "model-context-protocol", "claude", "cursor", "ai-tools", "text-tools", "remove-duplicates", "csv-to-json", "extract-emails", "json-formatter", "clean-text", "text", "csv", "json", "cloudflare-workers"],
  "license": "MIT",
  "author": "Sonjj",
  "homepage": "https://github.com/mr-sonj/ptext-core/tree/main/packages/mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mr-sonj/ptext-core.git",
    "directory": "packages/mcp"
  },
  "bugs": "https://github.com/mr-sonj/ptext-core/issues",
  "publishConfig": { "access": "public" }
}
